# Copy to .env (untracked). Never commit real secrets.
APP_ENV=production

# Required: comma separated "token:user:role" (role = admin|user). Generate long random tokens, e.g. `openssl rand -hex 32`.
EVALFORGE_API_KEYS=

# Database (SQLite on the shared /data volume by default; use PostgreSQL for multi-host deployments)
# DATABASE_URL=sqlite:////data/evalforge.db

# Mubit gateway (Claude storyboards). Leave MUBIT_API_KEY empty to use rule-based storyboards.
MUBIT_API_KEY=
MUBIT_ANTHROPIC_BASE_URL=https://api.mubit.ai/anthropic
MUBIT_ANTHROPIC_MODEL=claude-haiku-4-5

# Optional narration provider (none | http)
TTS_PROVIDER=none
TTS_ENDPOINT_URL=
TTS_API_KEY=
TTS_VOICES=default

# Ports / frontend
BACKEND_PORT=8000
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Local development only (ignored unless APP_ENV=development)
# AUTH_DISABLED=false

MLSTATSOFT_ENABLED=false
MLSTATSOFT_API_KEY=
